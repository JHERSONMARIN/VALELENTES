{
  "name": "valelentes",
  "version": "1.0.0",
  "description": "Sistema POS & Gestión para Óptica - VALE-LENTES by VT VALETEC",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "start:standalone": "node server-standalone.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.valetec.valelentes",
    "productName": "VALE-LENTES POS Óptica",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/img/logo.png"
    },
    "files": [
      "main.js",
      "server-standalone.js",
      "db-sqlite.js",
      "public/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
